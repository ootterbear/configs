#!/usr/bin/env bash
# tmux display-popup 용 yazi 래퍼.
#
# 동작 (실측):
#   - Enter 로 파일을 열면 그 자리에서 $EDITOR(vim)이 뜬다. vim 을 :q 로 나오면
#     yazi 가 종료되면서 방금 연 파일의 절대경로가 tmux 버퍼에 들어간다.
#   - 파일을 열지 않고 q 로 나오면 마지막 디렉터리 경로가 버퍼에 들어간다.
#   - 그래서 popup 이 닫힌 뒤 원래 pane 에서 prefix+] (paste-buffer) 로 붙여넣으면 된다.
#   - 대안: yazi 안에서 c c (경로 복사)는 OSC 52 로 곧장 클립보드에 들어간다.
#
# yazi 쪽 플래그 (26.x 확인):
#   --chooser-file : open(Enter) 으로 열린 파일 경로를 기록
#   --cwd-file     : 종료 시 마지막 디렉터리를 기록
set -u

# popup 은 `zsh -c`(비대화형)으로 뜬다 → ~/.zshrc 가 안 읽혀 ~/.local/bin 이 PATH 에 없다.
# yazi/fd/rg/zoxide 를 찾을 수 있도록 PATH 를 직접 보강하고, yazi 는 절대경로로도 잡아둔다.
export PATH="$HOME/.local/bin:$PATH"
YAZI_BIN="${YAZI_BIN:-$HOME/.local/bin/yazi}"

start_dir="${1:-$PWD}"
cwd_file="$(mktemp "${TMPDIR:-/tmp}/yazi-cwd.XXXXXX")"
chooser_file="$(mktemp "${TMPDIR:-/tmp}/yazi-chooser.XXXXXX")"
trap 'rm -f "$cwd_file" "$chooser_file"' EXIT

"$YAZI_BIN" "$start_dir" --cwd-file="$cwd_file" --chooser-file="$chooser_file"

if [ -s "$chooser_file" ]; then
    payload="$(head -n 1 "$chooser_file")"
    label="파일"
elif [ -s "$cwd_file" ]; then
    payload="$(head -n 1 "$cwd_file")"
    label="디렉터리"
else
    exit 0
fi

[ -n "$payload" ] || exit 0

if [ -n "${TMUX:-}" ]; then
    tmux set-buffer "$payload"
    tmux display-message "yazi: ${label} 경로를 버퍼에 복사 — ${payload}"
else
    printf '%s\n' "$payload"
fi
